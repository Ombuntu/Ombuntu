# Changes require a restart to take effect.
# Note: uwsm evaluates this file with /bin/sh (dash on Ubuntu), so keep it POSIX.

# Ensure Omarchy bins are in the path
export OMARCHY_PATH=$HOME/.local/share/omarchy
export PATH=$PATH:$OMARCHY_PATH/bin:$HOME/.local/bin

# Set default terminal and editor
. "$HOME/.config/uwsm/default"

# Activate mise if present on the system
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims)"
fi

# Opt out of telemetry in developer tools that honour these (consoledonottrack.com and friends)
export DO_NOT_TRACK=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export NEXT_TELEMETRY_DISABLED=1
export NUXT_TELEMETRY_DISABLED=1
export ASTRO_TELEMETRY_DISABLED=1
export GATSBY_TELEMETRY_DISABLED=1
export HOMEBREW_NO_ANALYTICS=1
export POWERSHELL_TELEMETRY_OPTOUT=1
export AZURE_CORE_COLLECT_TELEMETRY=0
export SAM_CLI_TELEMETRY=0
export STRIPE_CLI_TELEMETRY_OPTOUT=1
export HF_HUB_DISABLE_TELEMETRY=1
