#!/bin/bash
# Zed from its official tarball into ~/.local (what zed.dev/install.sh does, minus the pipe)
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
[[ -x ~/.local/zed.app/bin/zed ]] && { echo "Zed already installed"; exit 0; }
case "$(ombuntu_arch)" in amd64) a=x86_64 ;; arm64) a=aarch64 ;; *) exit 1 ;; esac
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
echo "Downloading Zed..."
curl -fL --retry 3 --progress-bar -o "$tmp/zed.tar.gz" "https://zed.dev/api/releases/stable/latest/zed-linux-$a.tar.gz"
mkdir -p ~/.local/bin ~/.local/share/applications
tar -xzf "$tmp/zed.tar.gz" -C "$tmp"
app=$(find "$tmp" -maxdepth 1 -type d -name 'zed*.app' | head -1)
[[ -n $app && -x $app/bin/zed ]] || { echo "Zed archive did not contain bin/zed" >&2; exit 1; }
rm -rf ~/.local/zed.app
mv "$app" ~/.local/zed.app
ln -sf ~/.local/zed.app/bin/zed ~/.local/bin/zed
ln -sf ~/.local/zed.app/bin/zed ~/.local/bin/zeditor
cp -f ~/.local/zed.app/share/applications/dev.zed.Zed.desktop ~/.local/share/applications/dev.zed.Zed.desktop
home_esc=$(printf '%s' "$HOME" | sed 's/[&|\\]/\\&/g')
sed -i "s|^Icon=.*|Icon=$home_esc/.local/zed.app/share/icons/hicolor/512x512/apps/zed.png|; s|^Exec=zed|Exec=\"$home_esc/.local/zed.app/bin/zed\"|" ~/.local/share/applications/dev.zed.Zed.desktop
update-desktop-database ~/.local/share/applications 2>/dev/null || true
mkdir -p ~/.config/zed
[[ -s ~/.config/zed/settings.json ]] || printf '{\n  "telemetry": { "diagnostics": false, "metrics": false }\n}\n' >~/.config/zed/settings.json
