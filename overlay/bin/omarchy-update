#!/bin/bash

# omarchy:summary=Update system packages (apt) and re-apply the Omarchy-on-Xubuntu overlay
# omarchy:args=[-y]
# omarchy:examples=omarchy update | omarchy update -y
# omarchy:requires-sudo=true

set -e

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\033[0m"' ERR

if [[ $1 != "-y" ]]; then
  gum confirm "Update Ubuntu packages and the Omarchy overlay now?" || exit 0
fi

sudo apt-get update
sudo apt-get full-upgrade -y
sudo apt-get autoremove -y

repo=$(cat "$OMARCHY_PATH/ombuntu-repo.path" 2>/dev/null)
if [[ -n $repo && -d $repo/.git ]]; then
  git -C "$repo" fetch -q --tags origin 2>/dev/null || echo "(could not reach the Ombuntu repository; using the local copy)"
  if git -C "$repo" symbolic-ref -q HEAD >/dev/null; then
    echo "Ombuntu checkout is on a branch (developer clone): pulling"
    git -C "$repo" pull -q --ff-only --no-rebase 2>/dev/null || true
  else
    latest=$(git -C "$repo" tag -l 'v[0-9]*' | sort -V | tail -1)
    current=$(git -C "$repo" describe --tags --exact-match 2>/dev/null)
    if [[ -n $latest && $latest != "$current" ]]; then
      echo "Ombuntu $current -> $latest"
      git -C "$repo" checkout -q --force "$latest"
    fi
  fi
  bash "$repo/install.sh" --user-only
fi

pkill -RTMIN+7 waybar 2>/dev/null || true
