#!/bin/bash
# NordVPN's official apt repository (added by their nordvpn-release package)
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
deb_install https://repo.nordvpn.com/deb/nordvpn/debian/pool/main/n/nordvpn-release/nordvpn-release_1.0.0_all.deb
sudo apt-get update -qq
sudo apt-get install -y nordvpn
