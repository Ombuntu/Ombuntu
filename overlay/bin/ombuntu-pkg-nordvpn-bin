#!/bin/bash
# NordVPN from its signed apt repository
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
apt_repo_add nordvpn https://repo.nordvpn.com/gpg/nordvpn_public.asc "deb https://repo.nordvpn.com/deb/nordvpn/debian stable main" BC5480EFEC5C081CE5BCFBE26B219E535C964CA1
sudo apt-get install -y nordvpn
