#!/bin/bash
# Ollama from its GitHub release archive, verified against the release's sha256sum.txt
# (the same files ollama.com/install.sh fetches, without piping a script into a shell).
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
variant=$(basename "$0"); variant=${variant#ombuntu-pkg-ollama}; variant=${variant#-}   # "" or rocm/cuda
command -v ollama >/dev/null && { echo "Ollama already installed ($(ollama --version 2>/dev/null))"; exit 0; }

OLLAMA_VERSION="${OLLAMA_VERSION:-$(curl -fsSL https://api.github.com/repos/ollama/ollama/releases/latest | jq -r .tag_name)}"
case "$(ombuntu_arch)" in amd64) asset=ollama-linux-amd64.tar.zst ;; arm64) asset=ollama-linux-arm64.tar.zst ;; *) echo "unsupported arch" >&2; exit 1 ;; esac
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
echo "Downloading Ollama $OLLAMA_VERSION (about 1.4 GB)..."
curl -fL --retry 3 --progress-bar -o "$tmp/$asset" "$(gh_asset_url ollama/ollama "$OLLAMA_VERSION" "$asset")"
curl -fsSL --retry 3 -o "$tmp/sha256sum.txt" "$(gh_asset_url ollama/ollama "$OLLAMA_VERSION" sha256sum.txt)"
verify_sha256_from_list "$tmp/$asset" "$tmp/sha256sum.txt"

omarchy-pkg-add zstd
echo "Installing to /usr/local..."
sudo tar --zstd --no-same-owner --no-same-permissions --owner=root --group=root -C /usr/local -xf "$tmp/$asset"
# AMD GPUs: Ollama ships the ROCm runtime as a second bundle on top of the base one (CUDA is in the base)
if [[ $variant == rocm && $(ombuntu_arch) == amd64 ]]; then
  rocm=ollama-linux-amd64-rocm.tar.zst
  echo "Downloading the ROCm bundle..."
  curl -fL --retry 3 --progress-bar -o "$tmp/$rocm" "$(gh_asset_url ollama/ollama "$OLLAMA_VERSION" "$rocm")"
  verify_sha256_from_list "$tmp/$rocm" "$tmp/sha256sum.txt"
  sudo tar --zstd --no-same-owner --no-same-permissions --owner=root --group=root -C /usr/local -xf "$tmp/$rocm"
fi

# systemd service, as ollama.com/install.sh creates it
if ! id ollama >/dev/null 2>&1; then
  sudo useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
fi
sudo usermod -a -G ollama "$(id -un)"
sudo tee /etc/systemd/system/ollama.service >/dev/null <<'UNIT'
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=default.target
UNIT
sudo systemctl daemon-reload
sudo systemctl enable --now ollama.service
echo
echo "Ollama is running. Try: ollama run llama3.2"
