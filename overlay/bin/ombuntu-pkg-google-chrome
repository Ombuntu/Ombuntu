#!/bin/bash
# Google Chrome from Google's signed apt repository (the same one the .deb would register)
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
command -v google-chrome >/dev/null && exit 0
[[ $(ombuntu_arch) == amd64 ]] || { echo "Google Chrome is amd64 only" >&2; exit 1; }
apt_repo_add google-chrome https://dl.google.com/linux/linux_signing_key.pub "deb [arch=amd64] https://dl.google.com/linux/chrome/deb/ stable main" EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
sudo apt-get install -y google-chrome-stable
