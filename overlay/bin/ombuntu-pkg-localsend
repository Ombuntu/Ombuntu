#!/bin/bash
# LocalSend from its pinned GitHub release .deb
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
command -v localsend_app >/dev/null && exit 0
v=$(pin LOCALSEND); k=$(arch_key); case $k in AMD64) a=x86-64 ;; ARM64) a=arm-64 ;; esac
deb_install "$(gh_asset_url localsend/localsend "$v" "LocalSend-${v#v}-linux-$a.deb")" "$(pin LOCALSEND "SHA256_$k")"
