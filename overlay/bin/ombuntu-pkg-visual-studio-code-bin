#!/bin/bash
# VS Code from Microsoft's apt repository
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
apt_repo_add vscode https://packages.microsoft.com/keys/microsoft.asc "deb [arch=amd64,arm64,armhf] https://packages.microsoft.com/repos/code stable main" BC528686B50D79E339D3721CEB3E94ADBE1229CF
sudo apt-get install -y code
