#!/bin/bash
# Helix from its pinned GitHub release tarball into ~/.local/helix
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
command -v hx >/dev/null && { echo "Helix already installed"; exit 0; }
v=$(pin HELIX); k=$(arch_key); case $k in AMD64) a=x86_64 ;; ARM64) a=aarch64 ;; esac
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
download_verified "$(gh_asset_url helix-editor/helix "$v" "helix-$v-$a-linux.tar.xz")" "$tmp/helix.tar.xz" "$(pin HELIX "SHA256_$k")"
mkdir -p "$tmp/helix" ~/.local/bin
tar -xJf "$tmp/helix.tar.xz" -C "$tmp/helix" --strip-components=1
[[ -x $tmp/helix/hx ]] || { echo "Helix archive did not contain hx" >&2; exit 1; }
rm -rf ~/.local/helix && mv "$tmp/helix" ~/.local/helix
ln -sf ~/.local/helix/hx ~/.local/bin/hx
ln -sf ~/.local/helix/hx ~/.local/bin/helix
mkdir -p ~/.config/helix && ln -sfn ~/.local/helix/runtime ~/.config/helix/runtime
