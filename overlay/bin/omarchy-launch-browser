#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]

# First real program of a .desktop Exec= line: skips a leading "env" and VAR=value words
# (snap entries look like "Exec=env BAMF_DESKTOP_FILE_HINT=... /snap/bin/firefox %u").
desktop_exec() {
  local f line word
  for f in ~/.local/share/applications/"$1" ~/.nix-profile/share/applications/"$1" /var/lib/snapd/desktop/applications/"$1" /usr/share/applications/"$1"; do
    [[ -f $f ]] || continue
    line=$(sed -n 's/^Exec=//p' "$f" | head -1)
    # shellcheck disable=SC2086
    for word in $line; do
      [[ $word == env || $word == *=* ]] && continue
      echo "$word"; return 0
    done
  done
  return 1
}

default_browser=$(xdg-settings get default-web-browser)
browser_exec=$(desktop_exec "$default_browser")

extra_flags=()
if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
else
  # Chromium-family browsers only use the GNOME keyring on desktops they recognise;
  # under Hyprland they fall back to plain-text storage and lose saved passwords.
  extra_flags=(--password-store=gnome-libsecret)
  if [[ $browser_exec =~ edge ]]; then
    private_flag="--inprivate"
  else
    private_flag="--incognito"
  fi
fi

args=()
for a in "$@"; do
  case $a in
  --private) args+=("$private_flag") ;;
  -*) echo "omarchy-launch-browser: refusing to pass browser flag $a" >&2; exit 2 ;;
  *) args+=("$a") ;;
  esac
done
exec setsid uwsm-app -- "$browser_exec" "${extra_flags[@]}" "${args[@]}"
