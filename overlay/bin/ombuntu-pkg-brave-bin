#!/bin/bash
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
apt_repo_add brave-browser https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg "deb [arch=amd64,arm64] https://brave-browser-apt-release.s3.brave.com/ stable main"
sudo apt-get install -y brave-browser
