#!/bin/bash
# 1Password from its official apt repository, with the debsig policy 1Password documents
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
[[ $(ombuntu_arch) == amd64 ]] || { echo "1Password publishes amd64 packages only" >&2; exit 1; }
apt_repo_add 1password https://downloads.1password.com/linux/keys/1password.asc "deb [arch=amd64] https://downloads.1password.com/linux/debian/amd64 stable main"
sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22 /usr/share/debsig/keyrings/AC2D62742012EA22
curl -fsSL --retry 3 https://downloads.1password.com/linux/debian/debsig/1password.pol | sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol >/dev/null
[[ -s /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg ]] || curl -fsSL --retry 3 https://downloads.1password.com/linux/keys/1password.asc | gpg --dearmor | sudo tee /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg >/dev/null
sudo apt-get install -y 1password
