#!/bin/bash
# Voxtype dictation from its pinned GitHub release binaries, verified against pinned SHA256s
# (the .deb upstream publishes is not listed in its SHA256SUMS, the raw binaries are).
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ombuntu-lib.sh"
set -e
command -v voxtype >/dev/null && exit 0
[[ $(ombuntu_arch) == amd64 ]] || { echo "Ombuntu installs Voxtype on amd64 only" >&2; exit 1; }
grep -qw avx2 /proc/cpuinfo || { echo "This CPU lacks AVX2, which Voxtype's binaries need" >&2; exit 1; }
VOXTYPE_VERSION=$(pin VOXTYPE); v="${VOXTYPE_VERSION#v}"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
mkdir -p ~/.local/bin
for asset in "voxtype-$v-linux-x86_64-avx2:voxtype:SHA256_AVX2" "voxtype-$v-linux-x86_64-audio-bridge:voxtype-audio-bridge:SHA256_AUDIO_BRIDGE"; do
  IFS=: read -r name dest key <<<"$asset"
  download_verified "$(gh_asset_url peteonrails/voxtype "$VOXTYPE_VERSION" "$name")" "$tmp/$name" "$(pin VOXTYPE "$key")"
  install -m 755 "$tmp/$name" ~/.local/bin/"$dest"
done
echo "Voxtype $v installed to ~/.local/bin"
